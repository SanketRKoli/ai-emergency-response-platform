# Copy this file to .env and fill in the values. Never commit .env.
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ai_emergency_response
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=1d
CLIENT_URL=http://localhost:5173
NODE_ENV=development
# Only if "querySrv ECONNREFUSED" appears when connecting to MongoDB Atlas (your network blocks SRV DNS lookups):
# DNS_SERVERS=8.8.8.8,1.1.1.1

# ---- AI classification (Stage 4) ----
# rules = keyword-rule baseline (default, needs nothing). gemini or anthropic = language model (needs a key below).
AI_PROVIDER=rules
# If the language model fails, fall back to the rules instead of leaving the report for manual review.
AI_FALLBACK_TO_RULES=true
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-5-5
